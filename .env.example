# ─── Supabase ────────────────────────────────────────────────
# Supabase 대시보드 > Settings > API 에서 확인
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── 카카오 ──────────────────────────────────────────────────
# https://developers.kakao.com > 앱 > 앱 키 > JavaScript 키
VITE_KAKAO_JS_KEY=your-kakao-javascript-key

# ─── 포트원 (I'mport) ─────────────────────────────────────────
# https://admin.portone.io > 결제 연동 > 가맹점 식별코드
VITE_IMP_CODE=imp00000000

# ─── 앱 URL ──────────────────────────────────────────────────
# 배포 후 실제 도메인으로 변경
VITE_APP_URL=http://localhost:5173
